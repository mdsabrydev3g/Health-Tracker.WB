# ─────────────────────────────────────────────────────────────
# Health Tracker — environment variables
# Copy to .env.local for development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — pooled connection string (used by the app at runtime).
# Neon console → Connection details → "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/health_tracker?sslmode=require"

# Neon direct (unpooled) connection — required by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/health_tracker?sslmode=require"

# Auth — signs the caregiver session cookie. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# First-run caregiver account (seeded by `npm run db:seed`). Change after first login.
SEED_CAREGIVER_EMAIL="caregiver@example.com"
SEED_CAREGIVER_PASSWORD=""

# Optional: AI lab/scan summarisation. NEVER expose this to the client.
# Called only from server-side route handlers / Vercel functions.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Optional: Vercel Blob token for medical document uploads.
# BLOB_READ_WRITE_TOKEN=""

# Public site URL (used for Web Push + absolute links in production).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
