<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Dose reminders are the critical path (§9). The LocalNotifications plugin
      already brings POST_NOTIFICATIONS, SCHEDULE_EXACT_ALARM,
      RECEIVE_BOOT_COMPLETED and WAKE_LOCK, and registers a boot receiver that
      restores pending alarms after reboot.

      The two below are declared here because the plugin does not:
    -->

    <!-- Vibration on the "تذكير الجرعات" channel. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Lets us offer the one-time "ignore battery optimizations" prompt. Without
      it Doze delays alarms and the reminder fires late — which for a cardiac
      medication is a real failure, not a cosmetic one.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Deliberately NOT declared: android.permission.USE_EXACT_ALARM.
      It is auto-granted (never revoked) but Google Play restricts it to alarm
      clock / calendar style apps, so declaring it risks rejection. We rely on
      SCHEDULE_EXACT_ALARM + canScheduleExactAlarms() and, if the user has
      revoked it, send them to the system settings screen instead of silently
      falling back to inexact alarms.
    -->
</manifest>
